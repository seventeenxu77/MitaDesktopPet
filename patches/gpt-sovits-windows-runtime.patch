--- a/install.ps1
+++ b/install.ps1
@@ -52,7 +52,14 @@ function Invoke-Conda {
         [string[]]$Args
     )
 
-    $output = & conda install -y -q -c conda-forge @Args 2>&1
+    # PowerShell resolves command names case-insensitively. Calling `conda`
+    # from inside Invoke-Conda can recurse into this function, so resolve the
+    # executable explicitly.
+    $condaExe = $env:CONDA_EXE
+    if (-not $condaExe) {
+        throw "CONDA_EXE is not set. Activate the target Conda environment before running install.ps1."
+    }
+    $output = & $condaExe install -y -q -c conda-forge @Args 2>&1
     $exitCode = $LASTEXITCODE
 
     if ($exitCode -ne 0) {
@@ -110,16 +117,17 @@ function Invoke-Download {
     )
 
     try {
-        $params = @{
-            Uri = $Uri
-        }
-
         if ($OutFile) {
-            $params["OutFile"] = $OutFile
+            # Invoke-WebRequest restarts large files after any connection drop.
+            # curl can resume the partial file and retry transient network errors.
+            & curl.exe -L --fail --retry 12 --retry-delay 3 --retry-all-errors `
+                --continue-at - --output $OutFile $Uri
+            if ($LASTEXITCODE -ne 0) {
+                throw "curl failed with exit code $LASTEXITCODE"
+            }
+        } else {
+            $null = Invoke-WebRequest -Uri $Uri -ErrorAction Stop
         }
-
-        $null = Invoke-WebRequest @params -ErrorAction Stop
-
     } catch {
         Write-Host "Failed to download:" -ForegroundColor Red
         Write-Host "  $Uri"
